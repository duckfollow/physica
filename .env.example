# Leave empty for localhost and root/custom-domain hosting.
# For a GitHub project site, set to /physica at build time.
NEXT_PUBLIC_BASE_PATH=
# Absolute origin for Open Graph / share previews (no trailing slash).
# GitHub project site example: https://duckfollow.github.io
NEXT_PUBLIC_SITE_URL=https://duckfollow.github.io
# Never put AI provider keys into NEXT_PUBLIC_* variables.
